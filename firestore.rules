rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CHANGE THIS to your Firebase Auth UID once you have signed in once (moderation gate).
    function isAdmin() { return request.auth != null && request.auth.uid == 'REPLACE_WITH_YOUR_UID'; }

    match /usernames/{name} {                         // public existence check; reserve-once
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && name == name.lower() && !exists(/databases/$(database)/documents/usernames/$(name));
      allow update, delete: if isAdmin();
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned','isGM','coin','creditScore'])
                    && (!('roleId' in resource.data) || request.resource.data.roleId == resource.data.roleId);
      allow update, delete: if isAdmin();
    }
    // Editor data (games, worlds, confs, vars, meta/index): owner-only. Docs are capped at 1 MB by Firestore itself.
    match /users/{uid}/{sub}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /published/{gid} {                          // public listing of published games
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /blobs/{id} {                               // images + published game packs (see backend/firebase-blobs.js)
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.size <= 8388608;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      match /c/{i} {
        allow read: if true;
        allow create: if request.auth != null && get(/databases/$(database)/documents/blobs/$(id)).data.uid == request.auth.uid;
        allow delete: if request.auth != null && get(/databases/$(database)/documents/blobs/$(id)).data.uid == request.auth.uid;
      }
    }
    match /counters/{c} {                              // numeric role ids: create at 1, or +1 only
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.n == 1;
      allow update: if request.auth != null && request.resource.data.n == resource.data.n + 1;
    }
    match /moderation/{doc=**} { allow read, write: if isAdmin(); }
    match /{other=**} { allow read, write: if false; }  // closed by default; open collections as handlers need them
  }
}
